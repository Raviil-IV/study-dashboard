# Данные для PostgreSQL-контейнера (нужны для docker compose)
POSTGRES_USER=study
POSTGRES_PASSWORD=change-me
POSTGRES_DB=study_dashboard

# Секрет для подписи JWT — поставь длинную случайную строку
JWT_SECRET=change-me-to-a-long-random-string

# Порт, на котором будет доступен фронтенд
FRONTEND_PORT=80